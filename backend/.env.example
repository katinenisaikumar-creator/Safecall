# Twilio Credentials (from Twilio Console -> Account Info)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Public HTTPS URL (e.g. your ngrok or Render URL, no trailing slash)
PUBLIC_BASE_URL=https://your-ngrok-url.ngrok-free.app

# Path to Firebase Admin SDK service account JSON downloaded from Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

PORT=3000
